{
  "name": "@tscircuit/autorouting-dataset-01",
  "version": "1.0.43",
  "type": "module",
  "main": "lib/dataset/index.ts",
  "bin": {
    "autorouting-dataset-runner": "./dist/cli/index.js"
  },
  "files": [
    "lib/dataset",
    "dist/cli",
    "dist/lib",
    "dist/scripts",
    "dist/types"
